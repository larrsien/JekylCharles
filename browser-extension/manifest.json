{
  "manifest_version": 3,
  "name": "Amon",
  "version": "1.0",
  "description": "Monitors browser activity for Amon Desktop Pet",
  "key": "",

  "permissions": [
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon128.png",
      "48": "icon128.png",
      "128": "icon128.png"
    }
  }
}